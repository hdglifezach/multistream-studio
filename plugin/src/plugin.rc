// Version resource for multistream-studio.dll.
// SignPath Foundation requires ProductName and ProductVersion on every signed binary; keep in step with VERSION.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Mistlight Studios"
            VALUE "FileDescription",  "Multistream Studio OBS plugin (vertical canvas and multistream outputs)"
            VALUE "FileVersion",      "1.1.0"
            VALUE "InternalName",     "multistream-studio"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Mistlight Studios. GPL-2.0-or-later."
            VALUE "OriginalFilename", "multistream-studio.dll"
            VALUE "ProductName",      "Multistream Studio"
            VALUE "ProductVersion",   "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
